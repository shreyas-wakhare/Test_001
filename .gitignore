# Virtual environments
.venv/
env/
venv/
ENV/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Sensitive data / credentials
.env
*.key
*.pem

# Engineering Data: Preserve raw immutability, ignore ephemeral/large runs
data/raw/*
!data/raw/.gitkeep
!data/raw/DOC-20260910-WA0008.pdf
data/processed/*
!data/processed/.gitkeep
data/validated/*
!data/validated/.gitkeep

# Numerical Model Simulation Outputs & Scratch
model/input/*
!model/input/.gitkeep
model/output/*
!model/output/.gitkeep
model/calibration/*
!model/calibration/.gitkeep
model/scenarios/*
!model/scenarios/.gitkeep

